{
  "name": "gym-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GymDesk: gym membership management on free Cloudflare tiers.",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply gym-management-system --local",
    "db:migrate:remote": "wrangler d1 migrations apply gym-management-system --remote",
    "db:seed:local": "wrangler d1 execute gym-management-system --local --file scripts/seed.sql",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "node scripts/check-deploy-branch.mjs && node scripts/check-config.mjs && npm run build && npm run bundle:api && (cd pages && wrangler pages deploy --project-name gymdeskapp --branch master --commit-dirty=false) && rm -f dist/_worker.js && wrangler deploy",
    "bundle:api": "wrangler deploy --dry-run --outdir .wrangler/api-bundle >/dev/null && cp .wrangler/api-bundle/index.js dist/_worker.js"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
